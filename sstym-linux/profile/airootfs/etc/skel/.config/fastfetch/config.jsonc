{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "source": "/usr/share/sstym/logo.png", "type": "kitty-direct", "width": 28, "height": 14 },
    "display": { "separator": "  " },
    "modules": [
        { "type": "title", "color": { "user": "magenta", "host": "cyan" } },
        "separator",
        { "type": "os", "key": "  OS" },
        { "type": "kernel", "key": "  Kernel" },
        { "type": "wm", "key": "  WM" },
        { "type": "shell", "key": "  Shell" },
        { "type": "packages", "key": "  Pkgs" },
        { "type": "memory", "key": "  RAM" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
