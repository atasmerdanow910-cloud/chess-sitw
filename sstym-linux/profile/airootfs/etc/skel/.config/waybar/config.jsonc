{
    "name": "menubar",
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 4,
    "modules-left": ["custom/logo", "hyprland/window"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["tray", "pulseaudio", "network", "cpu", "battery", "custom/settings", "custom/power", "clock"],

    "custom/logo": {
        "format": " ",
        "tooltip-format": "Sstym Linux — hack · learn · build",
        "on-click": "nwg-drawer"
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true,
        "rewrite": { "": "Sstym Linux" }
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "default": "○",
            "active": "●"
        }
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%H:%M:%S}"
    },
    "tray": { "spacing": 10, "icon-size": 16 },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": { "default": ["", "", ""] },
        "tooltip-format": "{volume}%",
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format": "{essid}  {ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "cpu": { "format": "", "tooltip-format": "CPU {usage}%", "interval": 3 },
    "battery": {
        "format": "{icon}",
        "format-charging": "",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{capacity}%"
    },
    "custom/settings": {
        "format": "",
        "tooltip-format": "Sstym Settings",
        "on-click": "sstym-settings"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power menu",
        "on-click": "sstym-powermenu"
    }
}
