{
    "name": "menubar",
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 4,
    "modules-left": [
        "image#logo",
        "custom/apps",
        "custom/places",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/vpn",
        "tray",
        "battery",
        "hyprland/language",
        "bluetooth",
        "pulseaudio",
        "custom/cc",
        "custom/power"
    ],
    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true,
        "rewrite": {
            "": ""
        }
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 1
        }
    },
    "clock": {
        "format": "{:%b %d   %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%A, %d %B %Y   %H:%M:%S}",
        "interval": 5
    },
    "tray": {
        "spacing": 10,
        "icon-size": 16
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },
        "tooltip-format": "{volume}%",
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format": "{essid}  {ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰁹"
        ],
        "states": {
            "warning": 25,
            "critical": 10
        },
        "tooltip-format": "{timeTo}"
    },
    "custom/vpn": {
        "format": "󰖂",
        "tooltip-format": "Sstym VPN — обход блокировок (SUPER+N)",
        "on-click": "sstym-vpn"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power menu",
        "on-click": "sstym-powermenu"
    },
    "custom/cc": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚<span foreground='#ff5b6e'><sup></sup></span>",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true,
        "restart-interval": 3
    },
    "image#logo": {
        "path": "/usr/share/sstym/logo.png",
        "size": 18,
        "tooltip": false,
        "on-click": "sstym-settings"
    },
    "custom/apps": {
        "format": "Apps",
        "tooltip-format": "Launchpad — all apps (SUPER+A)",
        "on-click": "nwg-drawer"
    },
    "custom/places": {
        "format": "Places",
        "tooltip-format": "Home, Documents, Downloads, USB drives…",
        "on-click": "sstym-places"
    },
    "hyprland/language": {
        "format": "{shortDescription}",
        "on-click": "hyprctl switchxkblayout all next",
        "tooltip-format": "{long}"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "",
        "format-off": "",
        "format-connected": "󰂱",
        "tooltip-format": "{controller_alias}",
        "on-click": "blueman-manager"
    }
}
