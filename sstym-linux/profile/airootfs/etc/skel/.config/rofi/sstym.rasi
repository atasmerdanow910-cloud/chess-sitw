* {
    bg:     #0a0e18f2;
    bg-alt: #12182c;
    fg:     #c6ccdb;
    accent: #7c4dff;
    cyan:   #00e5ff;
    background-color: transparent;
    text-color: @fg;
}
window { width: 640px; border-radius: 16px; background-color: @bg; border: 2px; border-color: @accent; padding: 18px; }
inputbar { children: [prompt, entry]; padding: 10px; background-color: @bg-alt; border-radius: 10px; margin: 0 0 12px 0; }
prompt { text-color: @cyan; margin: 0 8px 0 0; }
listview { lines: 9; scrollbar: false; spacing: 4px; }
element { padding: 10px; border-radius: 8px; }
element selected { background-color: @accent; text-color: #0a0e18; }
element-icon { size: 22px; margin: 0 10px 0 0; }
