# Sstym Linux branding: keep /usr/lib/os-release ours even after a filesystem upgrade.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem

[Action]
Description = Applying Sstym Linux os-release branding...
When = PostTransaction
Exec = /usr/bin/cp -f /usr/share/sstym/os-release /usr/lib/os-release
