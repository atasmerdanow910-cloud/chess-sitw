# Sstym Linux: use the Sstym boot splash (before the initramfs is generated).
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = plymouth

[Action]
Description = Setting the Sstym boot splash...
When = PostTransaction
Exec = /bin/sh -c 'printf "[Daemon]\nTheme=sstym\nShowDelay=0\nDeviceTimeout=8\n" > /etc/plymouth/plymouthd.conf'
