/* Sstym Cozy — Spotlight / menus */
* {
    bg: #2a1e15f0; bg-alt: #3a2b1f; fg: #f4e6d2; accent: #ffc978; accent-fg: #2a1d12;
    background-color: transparent; text-color: @fg;
}
window { width: 640px; border-radius: 18px; background-color: @bg; border: 1px; border-color: rgba(255,214,150,0.22); padding: 18px; }
inputbar { children: [prompt, entry]; padding: 12px; background-color: @bg-alt; border-radius: 12px; margin: 0 0 12px 0; }
prompt { text-color: @accent; margin: 0 8px 0 0; }
listview { lines: 9; scrollbar: false; spacing: 4px; }
element { padding: 10px; border-radius: 10px; }
element selected { background-color: @accent; text-color: @accent-fg; }
element-icon { size: 22px; margin: 0 10px 0 0; }
element-text { text-color: inherit; }
