#!/bin/bash
# Toggle Sstym "Game mode": hyprland.lua drops every effect while the flag
# file exists (no blur/shadows/animations/gaps), and gamemoded boosts the CPU.
STATE="${XDG_RUNTIME_DIR:-/tmp}/sstym-gamemode"
on()  { touch "$STATE"; hyprctl reload >/dev/null
        notify-send -i input-gaming "Game mode: ON" "Effects off — maximum FPS. Launch games with: gamemoderun %command%"; }
off() { rm -f "$STATE"; hyprctl reload >/dev/null
        notify-send -i input-gaming "Game mode: OFF" "Desktop effects restored"; }
case "${1:-toggle}" in
  on) on ;; off) off ;;
  *) if [ -f "$STATE" ]; then off; else on; fi ;;
esac
