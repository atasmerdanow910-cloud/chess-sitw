#!/bin/bash
# Toggle Sstym "Game mode": no blur/shadows/animations/gaps, tearing allowed.
STATE="${XDG_RUNTIME_DIR:-/tmp}/sstym-gamemode"
on() {
  hyprctl --batch "keyword animations:enabled false ; keyword decoration:blur:enabled false ; keyword decoration:shadow:enabled false ; keyword decoration:dim_inactive false ; keyword general:gaps_in 0 ; keyword general:gaps_out 0 ; keyword general:border_size 1 ; keyword decoration:rounding 0 ; keyword general:allow_tearing true" >/dev/null
  touch "$STATE"; notify-send -i input-gaming "Game mode" "ON — effects off, max performance"
}
off() {
  hyprctl reload >/dev/null; rm -f "$STATE"
  notify-send -i input-gaming "Game mode" "OFF — desktop effects restored"
}
case "${1:-toggle}" in
  on) on ;; off) off ;;
  *) [ -f "$STATE" ] && off || on ;;
esac
