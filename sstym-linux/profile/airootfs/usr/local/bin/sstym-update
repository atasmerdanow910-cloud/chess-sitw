#!/bin/bash
# Update system packages, AUR packages and Flatpak apps in one go.
exec kitty --class sstym-term --title "Sstym Update" -e bash -lc '
  echo -e "\e[1;36m== Sstym Linux update ==\e[0m"
  echo -e "\n\e[1m[1/3] System packages (pacman)\e[0m"; sudo pacman -Syu
  if command -v yay >/dev/null; then echo -e "\n\e[1m[2/3] AUR packages (yay)\e[0m"; yay -Sua; fi
  if command -v flatpak >/dev/null; then echo -e "\n\e[1m[3/3] Flatpak apps\e[0m"; flatpak update -y; fi
  echo -e "\n\e[1;32mAll up to date.\e[0m"; read -rp "Press Enter to close…"'
