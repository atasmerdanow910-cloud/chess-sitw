#!/bin/bash
# Sstym Settings — one menu for everything (macOS "System Settings" style).
term() { kitty --class sstym-term -e bash -lc "$1; echo; read -rp 'Press Enter to close…'"; }

choice=$(cat <<'EOF' | rofi -dmenu -i -p "Sstym Settings" -theme sstym
  VPN / обход блокировок
  Wi-Fi & Network
  Bluetooth
  Sound
󰍹  Displays
  Appearance (theme, icons, fonts)
  App Store (Flathub)
  Update everything
  Graphics drivers (NVIDIA / AMD / Intel)
  Game mode on/off
  Firewall on/off
  Security tools (BlackArch categories)
  Printers
  Disks
  Backups (Timeshift)
  Install Sstym Linux to disk
  About this computer
EOF
)

case "$choice" in
  *VPN*)            sstym-vpn & ;;
  *"Wi-Fi"*)        nm-connection-editor & ;;
  *Bluetooth*)      blueman-manager & ;;
  *Sound*)          pavucontrol & ;;
  *Displays*)       nwg-displays & ;;
  *Appearance*)     nwg-look & ;;
  *"App Store"*)    gnome-software & ;;
  *Update*)         sstym-update & ;;
  *drivers*)        sstym-driver & ;;
  *"Game mode"*)    sstym-gamemode toggle ;;
  *Firewall*)
      if sudo -n ufw status 2>/dev/null | grep -q "Status: active"; then
        term "sudo ufw disable && notify-send 'Firewall' 'Disabled'"
      else
        term "sudo ufw --force enable && notify-send 'Firewall' 'Enabled'"
      fi ;;
  *"Security tools"*) sstym-tools & ;;
  *Printers*)       system-config-printer & ;;
  *Disks*)          gnome-disks & ;;
  *Backups*)        pkexec timeshift-launcher & ;;
  *Install*)        sstym-install & ;;
  *About*)          term "fastfetch" ;;
esac
