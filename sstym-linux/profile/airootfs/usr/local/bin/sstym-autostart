#!/bin/bash
# Sstym Linux macOS-style desktop autostart
hyprctl setcursor Adwaita 24 &


# wallpaper
swaybg -i /usr/share/sstym/wallpaper.png -m fill &

# polkit agent (Calamares / pkexec)
/usr/lib/hyprpolkitagent/hyprpolkitagent 2>/dev/null &

# top menu bar
waybar -c "$HOME/.config/waybar/config.jsonc" -s "$HOME/.config/waybar/style.css" &

# macOS-style dock (always visible, launcher opens the Launchpad)
nwg-dock-hyprland -i 44 -mb 10 -p bottom -a center \
  -c nwg-drawer -ico /usr/share/sstym/logo.png -x &

# notifications, network applet, idle/lock
mako 2>/dev/null &
nm-applet --indicator 2>/dev/null &
hypridle 2>/dev/null &

# first-run welcome terminal
if [ ! -f "$HOME/.config/sstym-welcomed" ]; then
  touch "$HOME/.config/sstym-welcomed"
  sleep 1
  kitty --class sstym-term -e bash -lc 'fastfetch; echo
echo -e "\e[1;36mWelcome to Sstym Linux\e[0m — everyday desktop, gaming and security in one."
echo "  SUPER+Space  Spotlight search      SUPER+A  Launchpad (all apps)"
echo "  SUPER+I      Settings              SUPER+G  Game mode (max FPS)"
echo "  SUPER+Return Terminal              SUPER+B  Browser"
echo "  SUPER+U      Update everything     SUPER+SHIFT+I  Install to disk"
echo "  SUPER+N      VPN / обход блокировок (Tor, Lantern, Amnezia, Throne…)"
echo "  App Store: Settings → App Store (Flathub) · Security tools: Settings → Security tools"
echo; exec zsh' &
fi
