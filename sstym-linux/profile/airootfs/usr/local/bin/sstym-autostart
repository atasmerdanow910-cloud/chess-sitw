#!/bin/bash
# Sstym Linux macOS-style desktop autostart
hyprctl setcursor Adwaita 24 &


# wallpaper (chosen in Sstym Settings → Appearance)
WALL=$(cat "$HOME/.config/sstym/wallpaper" 2>/dev/null)
[ -f "$WALL" ] || WALL=/usr/share/sstym/wallpaper.png
swaybg -i "$WALL" -m fill &

# polkit agent (Calamares / pkexec)
/usr/lib/hyprpolkitagent/hyprpolkitagent 2>/dev/null &

# top menu bar
waybar -c "$HOME/.config/waybar/config.jsonc" -s "$HOME/.config/waybar/style.css" &

# macOS-style dock (auto-hide option in Sstym Settings)
sstym-dock

# Control Center + notifications (swaync) and theme widgets
sstym-theme start

# network applet, idle/lock
nm-applet --indicator 2>/dev/null &
hypridle 2>/dev/null &

# "Install Sstym Linux" boot entry → open the installer right away
if grep -qw 'sstym.install=1' /proc/cmdline; then
  (sleep 3; sstym-install) &
fi

# first run: the Sstym welcome screen
if [ ! -f "$HOME/.config/sstym/welcomed" ]; then
  mkdir -p "$HOME/.config/sstym"; touch "$HOME/.config/sstym/welcomed"
  (sleep 2; sstym-settings --welcome) &
fi
