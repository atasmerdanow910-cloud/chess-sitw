#!/bin/bash
# Create the passwordless live user for the Sstym Linux ISO.
set -e
U=sstym
if ! id "$U" &>/dev/null; then
  groups=""
  for g in wheel audio video input network storage power optical lp sys rfkill scanner; do
    getent group "$g" >/dev/null && groups="$groups,$g"
  done
  useradd -m -G "${groups#,}" -s /usr/bin/zsh "$U"
fi
passwd -d "$U" || true          # no password for live login
passwd -d root || true
# passwordless sudo for the live session
install -d -m 750 /etc/sudoers.d
echo "%wheel ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/10-sstym-live
chmod 440 /etc/sudoers.d/10-sstym-live
# autologin into the Sstym desktop (live session only; never in the image)
install -d /etc/sddm.conf.d
printf '[Autologin]\nUser=%s\nSession=sstym\n' "$U" > /etc/sddm.conf.d/20-sstym-live.conf
# passwordless polkit for the live session only (created at boot, never part of
# the image, so an installed system keeps normal password prompts)
install -d -m 750 /etc/polkit-1/rules.d
cat > /etc/polkit-1/rules.d/49-sstym-live.rules <<'RULES'
polkit.addRule(function(action, subject) {
    if (subject.isInGroup("wheel")) { return polkit.Result.YES; }
});
RULES
# make sure skel landed for an already-created home
cp -rn /etc/skel/. /home/$U/ 2>/dev/null || true
chown -R "$U:$U" /home/$U
exit 0
