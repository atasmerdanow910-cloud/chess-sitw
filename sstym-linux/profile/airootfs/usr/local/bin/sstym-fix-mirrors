#!/bin/sh
# Put the fast worldwide CDN mirrors at the top of the Arch mirror list.
f=/etc/pacman.d/mirrorlist
[ -f "$f" ] || exit 0
grep -q "geo.mirror.pkgbuild.com" "$f" && exit 0
tmp=$(mktemp)
{
  echo '# Sstym Linux: fast worldwide CDN mirrors first'
  echo 'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch'
  echo 'Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch'
  cat "$f"
} > "$tmp" && cat "$tmp" > "$f"
rm -f "$tmp"
