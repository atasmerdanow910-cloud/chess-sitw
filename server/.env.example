# Copy to .env and fill in. NEVER commit .env to git.
NODE_ENV=production
PORT=3000
# Postgres connection (docker-compose sets this for you)
DATABASE_URL=postgres://kerwen:CHANGE_ME@db:5432/kerwen
# Random secrets, at least 32 chars. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
MEDIA_SIGNING_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
MEDIA_DIR=/data/media
# Google Sign-In OAuth client IDs, comma separated (empty = Google login off)
GOOGLE_CLIENT_IDS=
# true when running behind Caddy/nginx
TRUST_PROXY=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Optional Firebase service account JSON path for push notifications
FCM_SERVICE_ACCOUNT_FILE=
