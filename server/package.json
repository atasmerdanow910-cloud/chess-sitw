{
  "name": "kerwen-market-server",
  "version": "1.0.0",
  "private": true,
  "description": "Kerwen Market API (NestJS + PostgreSQL)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:all": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/src/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/src/db/migrate.js",
    "db:seed": "node dist/src/db/seed.js",
    "create-owner": "node dist/src/scripts/create-owner.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 --test-reporter=spec 'dist/test/*.test.js'"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/platform-socket.io": "^12.6.0",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "^12.6.0",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
