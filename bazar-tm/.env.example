# Copy to .env and change every "change-me". Never commit .env.

# API server
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Comma-separated list of web origins allowed to call the API (the mobile app does not need CORS)
CORS_ORIGINS=https://bazar.example.com

# PostgreSQL
POSTGRES_DB=bazar
POSTGRES_USER=bazar
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://bazar:change-me@postgres:5432/bazar
# The server updates the database tables on start. Set to false to run "npm run migrate" yourself.
MIGRATE_ON_START=true

# Redis (rate limits shared between servers). Without REDIS_URL the limits are kept in memory.
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# Sign-in tokens. JWT_SECRET: at least 32 random characters, e.g. the output of
#   openssl rand -base64 48
# Changing it signs everybody out.
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Google sign-in: OAuth client IDs (Android, iOS, web), comma-separated. Empty: Google sign-in is off
# and the app offers phone + password only.
GOOGLE_CLIENT_IDS=
