# Copy to .env and change every "change-me". Never commit .env.

# API server
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# Comma-separated list of web origins allowed to call the API (the mobile app does not need CORS)
CORS_ORIGINS=https://bazar.example.com

# PostgreSQL (used from Day 2)
POSTGRES_DB=bazar
POSTGRES_USER=bazar
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://bazar:change-me@postgres:5432/bazar

# Redis (rate limits, chat presence — used from Day 2)
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
