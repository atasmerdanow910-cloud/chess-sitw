# Copy to deploy/.env (install.sh does it for you). NEVER commit deploy/.env.
# Your domain pointing to this server, e.g. api.kerwenmarket.com
DOMAIN=api.example.com
# Random secrets — install.sh fills them automatically.
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
MEDIA_SIGNING_SECRET=
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Google Sign-In: OAuth client IDs (Web + Android), comma separated. Empty = only phone+password.
GOOGLE_CLIENT_IDS=
# Push (optional): path INSIDE the api container to a Firebase service account JSON.
FCM_SERVICE_ACCOUNT_FILE=
